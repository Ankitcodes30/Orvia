{
	"name": "orvia",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "cross-env NODE_ENV=production BASE_PATH=/Orvia vite build",
		"postbuild": "node -e \"const fs = require('fs'); ['playlist', 'track', 'p', 'privacy', 'terms', 'licenses', 'help'].forEach(r => { if (fs.existsSync('build/' + r + '.html')) { fs.mkdirSync('build/' + r, { recursive: true }); fs.copyFileSync('build/' + r + '.html', 'build/' + r + '/index.html'); } });\"",
		"build:orvia": "cross-env NODE_ENV=production BASE_PATH=\"\" vite build",
		"build:gh-pages": "cross-env NODE_ENV=production BASE_PATH=/Orvia vite build",
		"preview": "cross-env NODE_ENV=production BASE_PATH=/Orvia vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "node test/verify_homepage_content.js",
		"deploy": "npm run build:gh-pages && gh-pages -d build"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"cross-env": "^7.0.3",
		"gh-pages": "^6.3.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0",
		"vite": "^7.0.4"
	},
	"dependencies": {
		"fflate": "^0.8.3"
	}
}
